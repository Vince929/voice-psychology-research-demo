# Production non-sensitive runtime configuration.
# Credentials, database URLs, and signing keys are injected from GitHub Secrets
# during deployment and must never be written in this file.

# Deployment target (non-sensitive IP address or DNS name).
SERVER_HOST=your-server-host
SERVER_USER=your-server-user

# Reuse the existing Vince COS bucket, isolated under this demo's key prefix.
AUDIO_COS_BUCKET=voice-psychology-prod-1304271127
AUDIO_COS_REGION=ap-shanghai
AUDIO_COS_KEY_PREFIX=voice-psychology

JWT_EXPIRE_HOURS=24
TENCENTCLOUD_APP_ID=1304271127

# Pin asr.cloud.tencent.com to Tencent's mainland ASR edge when necessary.
# Leave empty to use ordinary DNS resolution.
ASR_RESOLVE_IP=120.53.97.39

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEBUG_LLM_PROMPT=0
