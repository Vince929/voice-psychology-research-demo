# Local development uses the local EgoOps MySQL instance and this demo's own schema.
# For a fully self-contained database instead, run: ./cmd.sh db:up  (MySQL 8 on port 33061)
# and switch DATABASE_URL to mysql+pymysql://voice:voice123@127.0.0.1:33061/voice_psychology_demo?charset=utf8mb4
DATABASE_URL=mysql+pymysql://egoops:egoops@127.0.0.1:3306/voice_psychology_demo?charset=utf8mb4

# Reuse the existing Vince COS bucket, isolated under this demo's key prefix.
AUDIO_COS_BUCKET=voice-psychology-prod-1304271127
AUDIO_COS_REGION=ap-shanghai
AUDIO_COS_KEY_PREFIX=voice-psychology

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# JWT signing secret (>=32 bytes required for HS256; generate with: python3 -c "import secrets;print(secrets.token_hex(24))")
JWT_EXPIRE_HOURS=24

# Used by the production Docker Compose deployment.
TENCENTCLOUD_APP_ID=1304271127

# Pin asr.cloud.tencent.com to Tencent's mainland (Beijing) edge. On this
# network the domain resolves to Tencent's overseas edge where the flash ASR
# route does not exist (every voice message fails with HTTP 404). Verified
# 2026-09-27: full transcript succeeds via this IP; clear it if the IP stops
# serving (dig +short @119.29.29.29 asr.cloud.tencent.com +subnet=113.128.0.0/16
# returns the current mainland edge).
ASR_RESOLVE_IP=120.53.97.39
DEBUG_LLM_PROMPT=1
