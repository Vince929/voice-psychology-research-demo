# Local development database. DATABASE_URL must use a synchronous SQLAlchemy dialect.
DATABASE_URL=mysql+pymysql://<user>:<URL-encoded-password>@127.0.0.1:3306/<database>?charset=utf8mb4

# Planned deployment database. Keep this separate from DATABASE_URL until deployment.
DATABASE_URL_MASTER=mysql+pymysql://<user>:<URL-encoded-password>@127.0.0.1:3307/<database>?charset=utf8mb4

# Local path, or the controlled persistent path mounted by the deployment environment.
UPLOAD_AUDIO_DIR=/app/upload_audio

# Keep false for the ethical interview-demo mode.
ENABLE_DEEPSEEK_ANALYSIS=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
