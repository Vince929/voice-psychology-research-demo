# Local development database. DATABASE_URL must use a synchronous SQLAlchemy dialect.
DATABASE_URL=mysql+pymysql://<user>:<URL-encoded-password>@127.0.0.1:3306/<database>?charset=utf8mb4

# JWT signing secret for account authentication (set a random value locally).
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOURS=24

# Tencent Cloud Flash ASR credentials.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_APP_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
