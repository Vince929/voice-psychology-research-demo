# Local development database. DATABASE_URL must use a synchronous SQLAlchemy dialect.
DATABASE_URL=mysql+pymysql://<user>:<URL-encoded-password>@127.0.0.1:3306/<database>?charset=utf8mb4

# JWT signing secret for account authentication. HS256 requires >=32 bytes;
# generate one with: python3 -c "import secrets;print(secrets.token_hex(24))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes
JWT_EXPIRE_HOURS=24

# Tencent Cloud Flash ASR credentials.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENTCLOUD_APP_ID=

# Optional: pin asr.cloud.tencent.com to a fixed mainland Tencent edge IP.
# Only needed on networks whose DNS view resolves the domain to Tencent's
# overseas edge, where the flash ASR route returns nginx 404. Empty = normal DNS.
ASR_RESOLVE_IP=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
