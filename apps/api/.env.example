# Local development database. DATABASE_URL must use a synchronous SQLAlchemy dialect.
DATABASE_URL=mysql+pymysql://<user>:<URL-encoded-password>@127.0.0.1:3306/<database>?charset=utf8mb4

# Tencent COS stores uploaded audio. Use a dedicated bucket or prefix for this demo.
AUDIO_COS_BUCKET=<bucket-name>
AUDIO_COS_REGION=ap-shanghai
AUDIO_COS_SECRET_ID=
AUDIO_COS_SECRET_KEY=
AUDIO_COS_KEY_PREFIX=voice-psychology

# Tencent Cloud Flash ASR reuses the server-side SecretId and SecretKey above.
TENCENTCLOUD_APP_ID=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TASK_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=180
