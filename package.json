{
  "name": "voice-psychology-research-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "pnpm --filter @voice-psychology/mobile run start",
    "mobile:android": "pnpm --filter @voice-psychology/mobile run android",
    "mobile:android:usb": "pnpm --filter @voice-psychology/mobile run android:usb",
    "api:dev": "cd apps/api && uvicorn app.main:app --reload"
  }
}
