{
  "name": "voice-psychology-research-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm --workspace @voice-psychology/mobile run start",
    "mobile:android": "npm --workspace @voice-psychology/mobile run android",
    "mobile:android:usb": "npm --workspace @voice-psychology/mobile run android:usb",
    "api:dev": "cd apps/api && uvicorn app.main:app --reload"
  },
  "dependencies": {
    "react-native-nitro-modules": "0.29.2"
  }
}
